generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model activity {
  name                     String                     @db.VarChar
  activity_type            activitytypeenum
  activity_sub_type        activitysubtypeenum
  content                  Json?                      @db.Json
  details                  Json?                      @db.Json
  published                Boolean
  id                       Int                        @id @default(autoincrement())
  org_id                   Int?
  course_id                Int?
  activity_uuid            String                     @db.VarChar
  creation_date            String                     @db.VarChar
  update_date              String                     @db.VarChar
  current_version          Int
  last_modified_by_id      Int?
  course                   course?                    @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user                     user?                      @relation(fields: [last_modified_by_id], references: [id], onUpdate: NoAction)
  organization             organization?              @relation(fields: [org_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  activityversion          activityversion[]
  assignment               assignment[]
  assignmenttask           assignmenttask[]
  assignmenttasksubmission assignmenttasksubmission[]
  block                    block[]
  chapteractivity          chapteractivity[]
  course_embedding         course_embedding[]
  scormpackage             scormpackage[]
  scormruntimedata         scormruntimedata[]
  trailstep                trailstep[]

  @@index([activity_uuid], map: "ix_activity_activity_uuid")
  @@index([course_id], map: "ix_activity_course_id")
}

model activityversion {
  content        Json?         @db.Json
  version_number Int
  created_by_id  Int?
  id             Int           @id @default(autoincrement())
  activity_id    Int?
  org_id         Int?
  created_at     DateTime?     @db.Timestamp(6)
  activity       activity?     @relation(fields: [activity_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user           user?         @relation(fields: [created_by_id], references: [id], onUpdate: NoAction)
  organization   organization? @relation(fields: [org_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model apitoken {
  name               String       @db.VarChar(100)
  description        String?      @db.VarChar(500)
  rights             Json?        @db.Json
  id                 Int          @id @default(autoincrement())
  token_uuid         String       @db.VarChar(100)
  token_prefix       String       @db.VarChar(12)
  token_hash         String?      @db.VarChar(64)
  org_id             Int
  created_by_user_id Int
  creation_date      String       @db.VarChar
  update_date        String       @db.VarChar
  last_used_at       String?      @db.VarChar
  expires_at         String?      @db.VarChar
  is_active          Boolean
  user               user         @relation(fields: [created_by_user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  organization       organization @relation(fields: [org_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([org_id], map: "ix_apitoken_org_id")
  @@index([token_hash], map: "ix_apitoken_token_hash")
}

model assignment {
  title                    String                     @db.VarChar
  description              String                     @db.VarChar
  due_date                 String                     @db.VarChar
  published                Boolean?
  grading_type             gradingtypeenum
  id                       Int                        @id @default(autoincrement())
  creation_date            String?                    @db.VarChar
  update_date              String?                    @db.VarChar
  assignment_uuid          String                     @db.VarChar
  org_id                   Int?
  course_id                Int?
  chapter_id               Int?
  activity_id              Int?
  activity                 activity?                  @relation(fields: [activity_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  chapter                  chapter?                   @relation(fields: [chapter_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  course                   course?                    @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  organization             organization?              @relation(fields: [org_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  assignmenttask           assignmenttask[]
  assignmentusersubmission assignmentusersubmission[]
}

model assignmenttask {
  title                    String                     @db.VarChar
  description              String                     @db.VarChar
  hint                     String                     @db.VarChar
  reference_file           String?                    @db.VarChar
  assignment_type          assignmenttasktypeenum
  contents                 Json?                      @db.Json
  max_grade_value          Int
  id                       Int                        @id @default(autoincrement())
  assignment_task_uuid     String                     @db.VarChar
  creation_date            String                     @db.VarChar
  update_date              String                     @db.VarChar
  assignment_id            Int?
  org_id                   Int?
  course_id                Int?
  chapter_id               Int?
  activity_id              Int?
  activity                 activity?                  @relation(fields: [activity_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  assignment               assignment?                @relation(fields: [assignment_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  chapter                  chapter?                   @relation(fields: [chapter_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  course                   course?                    @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  organization             organization?              @relation(fields: [org_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  assignmenttasksubmission assignmenttasksubmission[]
}

model assignmenttasksubmission {
  assignment_task_submission_uuid String                 @db.VarChar
  task_submission                 Json?                  @db.Json
  grade                           Int
  task_submission_grade_feedback  String                 @db.VarChar
  assignment_type                 assignmenttasktypeenum
  user_id                         Int?
  activity_id                     Int?
  course_id                       Int?
  chapter_id                      Int?
  assignment_task_id              Int?
  id                              Int                    @id @default(autoincrement())
  creation_date                   String                 @db.VarChar
  update_date                     String                 @db.VarChar
  activity                        activity?              @relation(fields: [activity_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  assignmenttask                  assignmenttask?        @relation(fields: [assignment_task_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  chapter                         chapter?               @relation(fields: [chapter_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  course                          course?                @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user                            user?                  @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model assignmentusersubmission {
  id                            Int                            @id @default(autoincrement())
  creation_date                 String                         @db.VarChar
  update_date                   String                         @db.VarChar
  assignmentusersubmission_uuid String                         @db.VarChar
  submission_status             assignmentusersubmissionstatus
  grade                         Int
  user_id                       Int?
  assignment_id                 Int?
  assignment                    assignment?                    @relation(fields: [assignment_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user                          user?                          @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model auditlog {
  user_id      Int?
  org_id       Int?
  action       String        @db.VarChar
  resource     String        @db.VarChar
  resource_id  String?       @db.VarChar
  method       String        @db.VarChar
  path         String        @db.VarChar
  status_code  Int
  payload      Json?         @db.Json
  ip_address   String?       @db.VarChar
  created_at   DateTime      @db.Timestamp(6)
  id           Int           @id @default(autoincrement())
  organization organization? @relation(fields: [org_id], references: [id], onUpdate: NoAction)
  user         user?         @relation(fields: [user_id], references: [id], onUpdate: NoAction)
}

model block {
  id            Int           @id @default(autoincrement())
  block_type    blocktypeenum
  content       Json?         @db.Json
  org_id        Int?
  course_id     Int?
  chapter_id    Int?
  activity_id   Int?
  block_uuid    String        @db.VarChar
  creation_date String        @db.VarChar
  update_date   String        @db.VarChar
  activity      activity?     @relation(fields: [activity_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  chapter       chapter?      @relation(fields: [chapter_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  course        course?       @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  organization  organization? @relation(fields: [org_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model board {
  name            String        @db.VarChar
  description     String?       @db.VarChar
  thumbnail_image String?       @db.VarChar
  public          Boolean
  id              Int           @id @default(autoincrement())
  org_id          Int?
  board_uuid      String        @db.VarChar
  created_by      Int?
  ydoc_state      Bytes?
  creation_date   String        @db.VarChar
  update_date     String        @db.VarChar
  user            user?         @relation(fields: [created_by], references: [id], onUpdate: NoAction)
  organization    organization? @relation(fields: [org_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  boardmember     boardmember[]

  @@index([board_uuid], map: "ix_board_board_uuid")
  @@index([org_id], map: "ix_board_org_id")
}

model boardmember {
  id            Int    @id @default(autoincrement())
  board_id      Int?
  user_id       Int?
  role          String @db.VarChar
  creation_date String @db.VarChar
  board         board? @relation(fields: [board_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user          user?  @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([board_id], map: "ix_boardmember_board_id")
  @@index([user_id], map: "ix_boardmember_user_id")
}

model certificateuser {
  user_id                 Int?
  certification_id        Int?
  user_certification_uuid String          @db.VarChar
  id                      Int             @id @default(autoincrement())
  created_at              String          @db.VarChar
  updated_at              String          @db.VarChar
  certifications          certifications? @relation(fields: [certification_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user                    user?           @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model certifications {
  id                 Int               @id @default(autoincrement())
  certification_uuid String            @unique @db.VarChar
  course_id          Int?
  config             Json?             @db.Json
  creation_date      String            @db.VarChar
  update_date        String            @db.VarChar
  certificateuser    certificateuser[]
  course             course?           @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model chapter {
  name                     String                     @db.VarChar
  description              String?                    @db.VarChar
  thumbnail_image          String?                    @db.VarChar
  org_id                   Int?
  course_id                Int?
  id                       Int                        @id @default(autoincrement())
  chapter_uuid             String                     @db.VarChar
  creation_date            String                     @db.VarChar
  update_date              String                     @db.VarChar
  assignment               assignment[]
  assignmenttask           assignmenttask[]
  assignmenttasksubmission assignmenttasksubmission[]
  block                    block[]
  course                   course?                    @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  organization             organization?              @relation(fields: [org_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  chapteractivity          chapteractivity[]
  coursechapter            coursechapter[]
}

model chapteractivity {
  id            Int           @id @default(autoincrement())
  order         Int
  chapter_id    BigInt?
  activity_id   BigInt?
  course_id     BigInt?
  org_id        Int?
  creation_date String        @db.VarChar
  update_date   String        @db.VarChar
  activity      activity?     @relation(fields: [activity_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  chapter       chapter?      @relation(fields: [chapter_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  course        course?       @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  organization  organization? @relation(fields: [org_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([chapter_id], map: "ix_chapteractivity_chapter_id")
  @@index([course_id], map: "ix_chapteractivity_course_id")
}

model collection {
  name             String             @db.VarChar
  public           Boolean
  description      String?            @db.VarChar
  id               Int                @id @default(autoincrement())
  org_id           BigInt?
  collection_uuid  String             @db.VarChar
  creation_date    String             @db.VarChar
  update_date      String             @db.VarChar
  organization     organization?      @relation(fields: [org_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  collectioncourse collectioncourse[]
}

model collectioncourse {
  id            Int           @id @default(autoincrement())
  collection_id Int?
  course_id     Int?
  org_id        Int?
  creation_date String        @db.VarChar
  update_date   String        @db.VarChar
  collection    collection?   @relation(fields: [collection_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  course        course?       @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  organization  organization? @relation(fields: [org_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model community {
  name             String        @db.VarChar
  description      String?
  public           Boolean
  thumbnail_image  String?       @db.VarChar
  id               Int           @id @default(autoincrement())
  org_id           Int?
  course_id        Int?
  community_uuid   String        @db.VarChar
  moderation_words Json?         @db.Json
  creation_date    String        @db.VarChar
  update_date      String        @db.VarChar
  course           course?       @relation(fields: [course_id], references: [id], onUpdate: NoAction)
  organization     organization? @relation(fields: [org_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  discussion       discussion[]
}

model course {
  name                     String                     @db.VarChar
  description              String?                    @db.VarChar
  about                    String?                    @db.VarChar
  learnings                String?                    @db.VarChar
  tags                     String?                    @db.VarChar
  thumbnail_type           thumbnailtype?
  thumbnail_image          String?                    @db.VarChar
  thumbnail_video          String?                    @db.VarChar
  public                   Boolean
  published                Boolean
  open_to_contributors     Boolean
  id                       Int                        @id @default(autoincrement())
  org_id                   Int?
  course_uuid              String                     @db.VarChar
  creation_date            String                     @db.VarChar
  update_date              String                     @db.VarChar
  seo                      Json?
  activity                 activity[]
  assignment               assignment[]
  assignmenttask           assignmenttask[]
  assignmenttasksubmission assignmenttasksubmission[]
  block                    block[]
  certifications           certifications[]
  chapter                  chapter[]
  chapteractivity          chapteractivity[]
  collectioncourse         collectioncourse[]
  community                community[]
  organization             organization?              @relation(fields: [org_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  course_embedding         course_embedding[]
  coursechapter            coursechapter[]
  courseupdate             courseupdate[]
  paymentscourse           paymentscourse[]
  playground               playground[]
  scormpackage             scormpackage[]
  trailrun                 trailrun[]
  trailstep                trailstep[]

  @@index([course_uuid], map: "ix_course_course_uuid")
  @@index([org_id], map: "ix_course_org_id")
}

model course_embedding {
  id            Int                    @id @default(autoincrement())
  org_id        Int?
  course_id     Int?
  activity_id   Int?
  activity_uuid String                 @db.VarChar
  block_uuid    String?                @db.VarChar
  source_type   String                 @db.VarChar
  chunk_text    String?
  chunk_index   Int
  activity_name String                 @db.VarChar
  chapter_name  String                 @db.VarChar
  course_name   String                 @db.VarChar
  embedding     Unsupported("vector")?
  creation_date String                 @db.VarChar
  update_date   String                 @db.VarChar
  activity      activity?              @relation(fields: [activity_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  course        course?                @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  organization  organization?          @relation(fields: [org_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([course_id], map: "ix_course_embedding_course_id")
  @@index([org_id], map: "ix_course_embedding_org_id")
}

model coursechapter {
  id            Int           @id @default(autoincrement())
  order         Int
  course_id     Int?
  chapter_id    Int?
  org_id        Int?
  creation_date String        @db.VarChar
  update_date   String        @db.VarChar
  chapter       chapter?      @relation(fields: [chapter_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  course        course?       @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  organization  organization? @relation(fields: [org_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([chapter_id], map: "ix_coursechapter_chapter_id")
  @@index([course_id], map: "ix_coursechapter_course_id")
}

model courseupdate {
  id                    Int           @id @default(autoincrement())
  courseupdate_uuid     String        @db.VarChar
  title                 String        @db.VarChar
  content               String        @db.VarChar
  course_id             Int?
  linked_activity_uuids String?       @db.VarChar
  org_id                Int?
  creation_date         String        @db.VarChar
  update_date           String        @db.VarChar
  course                course?       @relation(fields: [course_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  organization          organization? @relation(fields: [org_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}

model customdomain {
  primary            Boolean
  id                 Int          @id @default(autoincrement())
  domain_uuid        String       @unique(map: "ix_customdomain_domain_uuid") @db.VarChar(100)
  domain             String       @unique @db.VarChar(255)
  org_id             BigInt
  status             String       @db.VarChar(50)
  verification_token String       @db.VarChar(100)
  creation_date      String       @db.VarChar
  update_date        String       @db.VarChar
  verified_at        String?      @db.VarChar
  last_check_at      String?      @db.VarChar
  check_error        String?      @db.VarChar
  organization       organization @relation(fields: [org_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([org_id], map: "ix_customdomain_org_id")
}

model discussion {
  title              String               @db.VarChar
  content            String?
  label              String?              @db.VarChar(50)
  emoji              String?              @db.VarChar(50)
  id                 Int                  @id @default(autoincrement())
  community_id       Int?
  org_id             Int?
  author_id          Int?
  discussion_uuid    String               @db.VarChar
  upvote_count       Int
  edit_count         Int
  is_pinned          Boolean?
  is_locked          Boolean?
  creation_date      String               @db.VarChar
  update_date        String               @db.VarChar
  user               user?                @relation(fields: [author_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  community          community?           @relation(fields: [community_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  organization       organization?        @relation(fields: [org_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  discussioncomment  discussioncomment[]
  discussionreaction discussionreaction[]
  discussionvote     discussionvote[]
}

model discussioncomment {
  content               String?
  id                    Int                     @id @default(autoincrement())
  discussion_id         Int?
  author_id             Int?
  comment_uuid          String                  @db.VarChar
  upvote_count          Int
  creation_date         String                  @db.VarChar
  update_date           String                  @db.VarChar
  user                  user?                   @relation(fields: [author_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  discussion            discussion?             @relation(fields: [discussion_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  discussioncommentvote discussioncommentvote[]
}

model discussioncommentvote {
  id                Int                @id @default(autoincrement())
  comment_id        Int?
  user_id           Int?
  vote_uuid         String             @db.VarChar
  creation_date     String             @db.VarChar
  discussioncomment discussioncomment? @relation(fields: [comment_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user              user?              @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([comment_id, user_id], map: "unique_comment_user_vote")
}

model discussionreaction {
  id            Int         @id @default(autoincrement())
  discussion_id Int?
  user_id       Int?
  emoji         String?     @db.VarChar(50)
  reaction_uuid String      @db.VarChar
  creation_date String      @db.VarChar
  discussion    discussion? @relation(fields: [discussion_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user          user?       @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([discussion_id, user_id, emoji], map: "unique_discussion_user_emoji")
}

model discussionvote {
  id            Int         @id @default(autoincrement())
  discussion_id Int?
  user_id       Int?
  vote_uuid     String      @db.VarChar
  creation_date String      @db.VarChar
  discussion    discussion? @relation(fields: [discussion_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user          user?       @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([discussion_id, user_id], map: "unique_discussion_user_vote")
}

model docgroup {
  name          String           @db.VarChar
  description   String?          @db.VarChar
  icon          String?          @db.VarChar
  group_type    docgrouptypeenum
  order         Int
  id            Int              @id @default(autoincrement())
  org_id        Int?
  docspace_id   Int?
  docsection_id Int?
  docgroup_uuid String           @db.VarChar
  api_config    Json?
  creation_date String           @db.VarChar
  update_date   String           @db.VarChar
  docsection    docsection?      @relation(fields: [docsection_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  docspace      docspace?        @relation(fields: [docspace_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  organization  organization?    @relation(fields: [org_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  docpage       docpage[]

  @@index([docgroup_uuid], map: "ix_docgroup_docgroup_uuid")
  @@index([docsection_id], map: "ix_docgroup_docsection_id")
  @@index([docspace_id], map: "ix_docgroup_docspace_id")
  @@index([org_id], map: "ix_docgroup_org_id")
}

model docpage {
  name           String          @db.VarChar
  page_type      docpagetypeenum
  icon           String?         @db.VarChar
  published      Boolean
  order          Int
  id             Int             @id @default(autoincrement())
  org_id         Int?
  docspace_id    Int?
  docsection_id  Int?
  docgroup_id    Int?
  parent_page_id Int?
  docpage_uuid   String          @db.VarChar
  slug           String          @db.VarChar
  content        Json?
  creation_date  String          @db.VarChar
  update_date    String          @db.VarChar
  docgroup       docgroup?       @relation(fields: [docgroup_id], references: [id], onUpdate: NoAction)
  docsection     docsection?     @relation(fields: [docsection_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  docspace       docspace?       @relation(fields: [docspace_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  organization   organization?   @relation(fields: [org_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  docpage        docpage?        @relation("docpageTodocpage", fields: [parent_page_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  other_docpage  docpage[]       @relation("docpageTodocpage")

  @@index([docgroup_id], map: "ix_docpage_docgroup_id")
  @@index([docpage_uuid], map: "ix_docpage_docpage_uuid")
  @@index([docsection_id], map: "ix_docpage_docsection_id")
  @@index([docspace_id], map: "ix_docpage_docspace_id")
  @@index([org_id], map: "ix_docpage_org_id")
  @@index([parent_page_id], map: "ix_docpage_parent_page_id")
}

model docsection {
  name            String        @db.VarChar
  description     String?       @db.VarChar
  icon            String?       @db.VarChar
  published       Boolean
  order           Int
  id              Int           @id @default(autoincrement())
  org_id          Int?
  docspace_id     Int?
  docsection_uuid String        @db.VarChar
  slug            String        @db.VarChar
  creation_date   String        @db.VarChar
  update_date     String        @db.VarChar
  docgroup        docgroup[]
  docpage         docpage[]
  docspace        docspace?     @relation(fields: [docspace_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  organization    organization? @relation(fields: [org_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

